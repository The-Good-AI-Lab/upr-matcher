    "source_rows": [
      {
        "language": "es",
        "source_id": "costa_rica_2024:discrimination:1",
        "text": "Fomentar un espacio seguro para las minorías discriminadas mediante la creación de centros de denuncia y apoyo para víctimas de todo tipo de discriminación, especialmente a niños, niñas, adolescentes, indígenas, migrantes y mujeres.",
        "theme": "DISCRIMINATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:discrimination:2",
        "text": "Redoblar esfuerzos en la implementación de su Política Nacional para la Igualdad y la Equidad de Género.",
        "theme": "DISCRIMINATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:discrimination:3",
        "text": "Fomentar la no discriminación hacia personas con discapacidad, mediante la creación de programas que los ayuden incorporarse en la sociedad de una forma inclusiva, incluyendo la creación de campañas de sensibilización para la sociedad con el objetivo de erradicar su discriminación.",
        "theme": "DISCRIMINATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_education:1",
        "text": "Asegurar la calidad de la educación, a través la creación de un plan de financiamiento con el fin de invertir en la mejora de las estructuras educativas públicas.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_education:2",
        "text": "Ofrecer a los docentes de educación primaria y secundaria programas de formación y capacitación para un mejor desempeño en el aula educativa.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_education:3",
        "text": "Otorgar a los estudiantes de bajos recursos, migrantes, indígenas y los que viven en las zonas rurales un apoyo económico para poder continuar con sus estudios y reducir la tasa de abandono escolar.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_education:4",
        "text": "Asegurar y agilizar el acceso, especialmente de niños y jóvenes con menos recursos, becas de adquisición de materiales y de comedor escolar.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_education:5",
        "text": "Habilitar espacios para que las voces de niños y jóvenes puedan ser escuchadas, especialmente en espacios educativos y sociales.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_health:1",
        "text": "Redoblar esfuerzos en la creación de campañas de concientización sobre el daño perjudicial del consumo de estupefacientes en el país, especialmente dirigidos a niños, niñas y adolescentes.",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_health:2",
        "text": "Tomar medidas más estrictas sobre la adquisición de medicamentos que requieran prescripción médica",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_health:3",
        "text": "Crear un sistema de recopilación de datos más específicos que incluya el tratamiento, seguimiento y número de casos de VIH/SIDA",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_health:4",
        "text": "Realizar campañas de concientización para erradicar la estigmatización hacia las personas con VIH/SIDA.",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:right_to_health:5",
        "text": "Redoblar esfuerzos en la prevención del suicido mediante campañas de acompañamiento psicológico",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:sexual_exploitation_and_trafficking:1",
        "text": "La Creación de centros de rehabilitación psicológica de víctimas de trata con personal capacitado para darle seguimiento a los casos.",
        "theme": "SEXUAL EXPLOITATION AND TRAFFICKING"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:sexual_exploitation_and_trafficking:2",
        "text": "Supervisar el seguimiento de las denuncias penales sobre los casos de trata, para evitar el entorpecimiento y la corrupción en la ejecución de los mismos.",
        "theme": "SEXUAL EXPLOITATION AND TRAFFICKING"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:sexual_exploitation_and_trafficking:3",
        "text": "Reforzar las medidas de las leyes y políticas sobre la atención a víctimas de trata.",
        "theme": "SEXUAL EXPLOITATION AND TRAFFICKING"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:transport_and_infrastructure:1",
        "text": "Mejorar la infraestructura vial del país.",
        "theme": "TRANSPORT AND INFRASTRUCTURE"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:transport_and_infrastructure:2",
        "text": "Implementar un plan de transporte público más amplio y más económico.",
        "theme": "TRANSPORT AND INFRASTRUCTURE"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:transport_and_infrastructure:3",
        "text": "Crear sistemas de transporte alternativos y no contaminantes.",
        "theme": "TRANSPORT AND INFRASTRUCTURE"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:violence_against_children:1",
        "text": "Intensificar esfuerzos en el sistema penal y seguimiento de casos de violencia doméstica, sexual y corporal, para agilizar los procesos administrativos.",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:violence_against_children:2",
        "text": "Crear un plan de supervisión en los centros policiacos para evitar la corrupción y o evitación de los casos de violencia especialmente hacia niños, niñas y adolescentes.",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:violence_against_children:3",
        "text": "Redoblar esfuerzos en la creación de campañas de concientización para prevenir y erradicar todo tipo de violencia.",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:violence_against_children:4",
        "text": "Garantizar, mediante una mayor vigilancia policial, espacios públicos seguros (zonas de ocios, jardines…).",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:young_peoples_rights:1",
        "text": "Realizar planes nacionales para otorgar mayores oportunidades de empleo para los jóvenes",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:young_peoples_rights:2",
        "text": "Crear planes de capacitación y formación para los jóvenes que no cuentan con educación superior y puedan entrar al mercado laboral",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:young_peoples_rights:3",
        "text": "Crear campañas de concientización del uso de drogas en los jóvenes para evitar su decadencia e introducción a la delincuencia.",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      },
      {
        "language": "es",
        "source_id": "costa_rica_2024:young_peoples_rights:4",
        "text": "Aumentar las ayudas a aquellos jóvenes que deseen acceder a la universidad, proporcionando becas de estudios que incluyan alojamiento y alimentación.",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      }
    ]
  },

    "source_rows": [
      {
        "language": "en",
        "source_id": "costa_rica_2024:discrimination:1",
        "text": "Promote a safe space for discriminated minorities by creating reporting and support centers for victims of all types of discrimination, especially children, adolescents, indigenous people, migrants and women.",
        "theme": "DISCRIMINATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:discrimination:2",
        "text": "Redouble efforts in the implementation of its National Policy for Gender Equality and Equity.",
        "theme": "DISCRIMINATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:discrimination:3",
        "text": "Promote non-discrimination towards people with disabilities, through the creation of programs that help them to integrate into society in an inclusive way, including the creation of awareness campaigns for society with the aim of eradicating their discrimination.",
        "theme": "DISCRIMINATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_education:1",
        "text": "Ensure the quality of education, through the creation of a financing plan in order to invest in the improvement of public educational structures.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_education:2",
        "text": "To offer primary and secondary school teachers training and development programs for better performance in the educational classroom.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_education:3",
        "text": "Provide financial support to low-income students, migrants, indigenous people, and those living in rural areas so they can continue their studies and reduce the school dropout rate.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_education:4",
        "text": "Ensure and expedite access, especially for children and young people with fewer resources, to scholarships for the purchase of materials and school meals.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_education:5",
        "text": "Create spaces where the voices of children and young people can be heard, especially in educational and social settings.",
        "theme": "RIGHT TO EDUCATION"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_health:1",
        "text": "Redouble efforts in creating awareness campaigns about the harmful effects of drug use in the country, especially targeting children and adolescents.",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_health:2",
        "text": "Take stricter measures regarding the acquisition of prescription medications",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_health:3",
        "text": "Create a more specific data collection system that includes treatment, follow-up, and number of HIV/AIDS cases",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_health:4",
        "text": "Conduct awareness campaigns to eradicate stigmatization towards people with HIV/AIDS.",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:right_to_health:5",
        "text": "Redouble efforts in suicide prevention through psychological support campaigns",
        "theme": "RIGHT TO HEALTH"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:sexual_exploitation_and_trafficking:1",
        "text": "The creation of psychological rehabilitation centers for victims of trafficking with trained personnel to follow up on cases.",
        "theme": "SEXUAL EXPLOITATION AND TRAFFICKING"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:sexual_exploitation_and_trafficking:2",
        "text": "Monitor the follow-up of criminal complaints on trafficking cases, to prevent obstruction and corruption in their execution.",
        "theme": "SEXUAL EXPLOITATION AND TRAFFICKING"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:sexual_exploitation_and_trafficking:3",
        "text": "Strengthen the measures of laws and policies on the care of victims of trafficking.",
        "theme": "SEXUAL EXPLOITATION AND TRAFFICKING"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:transport_and_infrastructure:1",
        "text": "Improve the country's road infrastructure.",
        "theme": "TRANSPORT AND INFRASTRUCTURE"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:transport_and_infrastructure:2",
        "text": "Implement a broader and cheaper public transport plan.",
        "theme": "TRANSPORT AND INFRASTRUCTURE"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:transport_and_infrastructure:3",
        "text": "Create alternative and non-polluting transport systems.",
        "theme": "TRANSPORT AND INFRASTRUCTURE"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:violence_against_children:1",
        "text": "Intensify efforts in the criminal justice system and monitoring of cases of domestic, sexual and physical violence, to expedite administrative processes.",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:violence_against_children:2",
        "text": "Create a monitoring plan in police stations to prevent corruption and avoid cases of violence, especially towards children and adolescents.",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:violence_against_children:3",
        "text": "Redouble efforts in creating awareness campaigns to prevent and eradicate all types of violence.",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:violence_against_children:4",
        "text": "Guarantee safe public spaces (leisure areas, gardens, etc.) through increased police surveillance.",
        "theme": "VIOLENCE AGAINST CHILDREN"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:young_peoples_rights:1",
        "text": "Develop national plans to provide greater employment opportunities for young people",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:young_peoples_rights:2",
        "text": "Create training and education plans for young people without higher education so they can enter the labor market",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:young_peoples_rights:3",
        "text": "Create awareness campaigns about drug use among young people to prevent their decline and introduction into crime.",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      },
      {
        "language": "en",
        "source_id": "costa_rica_2024:young_peoples_rights:4",
        "text": "Increase support for young people who wish to attend university, providing scholarships that include accommodation and food.",
        "theme": "YOUNG PEOPLE'S RIGHTS"
      }
    ]
  },
